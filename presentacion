\section{Introducción}
\begin{frame}{Tres decisiones que hoy toma el software}
  \begin{itemize}
    \item \textbf{Qué vemos:} algoritmos que ordenan el debate público.
    \item \textbf{Qué creemos:} microsegmentación y deepfakes.
    \item \textbf{Si podemos conectarnos:} apagones de internet.
  \end{itemize}
  \vspace{0.5cm}
  {\large\alert{Y una respuesta: el software libre.}}
\end{frame}

\begin{frame}{Qué tiene que ver el SW libre?}
  \begin{itemize}
    \textbf{UN CÓDIGO QUE CUALQUIERA PUEDE REVISAR Y QUE NADIE PUEDE CONTROLAR NI APAGAR EN SOLITARIO}
  \end{itemize}
  \vspace{0.5cm}
\end{frame}

\section{Desinformación}
\begin{frame}{Cambridge Analytica}
  \cifra{87 millones}{de perfiles recogidos con solo 305.000 tests}
  \begin{itemize}
    \item Facebook dejaba a las apps leer los datos de los amigos.
    \item Se usaron para mensajes políticos a medida (EE.\,UU., 2016).
    \item Multa récord de 5.000 M\$ de la FTC.
  \end{itemize}
\end{frame}

\begin{frame}{Deepfake: el audio falso de Eslovaquia (2023)}
  \begin{itemize}
    \item Dos días antes de votar aparece un audio falso de un candidato.
    \item Cae en el silencio electoral: casi no se puede desmentir.
    \item El candidato, primero en las encuestas, pierde.
  \end{itemize}
  \vspace{0.5cm}
  {\large\alert{Matiz:} no fue la única causa, pero un audio clonado es muy difícil de detectar.}
\end{frame}

\begin{frame}{Algoritmos: una caja negra}
  \begin{itemize}
    \item Optimizan la atención, no la información.
    \item Su código no es público.
    \item Crean cámaras de eco.
    \item La UE (DSA, art.\,38) obliga a ofrecer un feed sin perfilado.
  \end{itemize}
  \vspace{0.5cm}
  {\large\alert{Solo el código abierto permite auditar.}}
\end{frame}

\section{Apagones}
\begin{frame}{Cómo se apaga internet}
  \begin{itemize}
    \item \textbf{BGP:} el país desaparece del mapa de internet (Egipto, 2011).
    \item \textbf{DNS:} se bloquean webs concretas (Turquía, 2014).
    \item \textbf{Ralentizar:} la red funciona, pero no sirve (Irán, 2026).
    \item \textbf{Destruir:} se bombardean cables y antenas (Gaza).
  \end{itemize}
  \cifra{313 apagones}{en 52 países solo en 2025}
\end{frame}

\begin{frame}{Tres casos}
  \begin{columns}[T]
    \column{0.32\textwidth}
      \cifra{85}{apagones en Myanmar (2024)}
    \column{0.32\textwidth}
      \cifra{$\sim$70\,\%}{de 2026 sin internet en Irán}
    \column{0.32\textwidth}
      \cifra{7 días}{de apagón total en Gaza (2024)}
  \end{columns}
  \vspace{0.4cm}
  \begin{center}
    Los apagones acompañan a la represión y a la guerra.
  \end{center}
\end{frame}

\begin{frame}{Censura y desinformación se refuerzan}
  \vspace{0.5cm}
  \begin{center}
    {\Large Con Irán desconectado, el régimen pudo hacer pasar vídeos reales por deepfakes.}\\[1cm]
    \alert{\Large Sin red, nadie puede verificar.}
  \end{center}
\end{frame}

\section{Software libre}
\begin{frame}{Tor y Snowflake: todos podemos ser puente}
  \begin{enumerate}
    \item Una persona censurada no puede conectarse a Tor.
    \item Se conecta a través del navegador de un voluntario.
    \item Desde ahí llega a internet sin censura.
  \end{enumerate}
  \cifra{9,6 millones}{de iraníes al día usaron Psiphon en 2026}
\end{frame}

\begin{frame}{Redes sin centro}
  \begin{columns}[T]
    \column{0.48\textwidth}
      \textbf{Redes mesh} (Briar)
      \begin{itemize}
        \item De móvil a móvil, sin operador.
        \item Funcionan aunque caiga la red.
      \end{itemize}
    \column{0.48\textwidth}
      \textbf{Fediverso} (Mastodon)
      \begin{itemize}
        \item Miles de servidores independientes.
        \item Nadie puede apagarlo entero.
      \end{itemize}
  \end{columns}
  \vspace{0.6cm}
  {\large\alert{Si no hay centro, no hay interruptor.}}
\end{frame}

